// `schema-diff`, read-only (#410 story 4): staging's public schema against production's, grants and policies
// included, read from each catalog in one read-only transaction. Any difference is a stop: staging is brought level
// by ordinary migration work (export first, staging only) before its export.
import type { Command, Target } from "../command.mts";
import { readOnly, type Sql } from "../database.mts";

// Not an extension's own object: extensions are installed per project and aren't Lane's schema.
const NOT_EXTENSION = (catalog: string, oid: string) =>
  `not exists (select 1 from pg_depend d where d.classid = '${catalog}'::regclass and d.objid = ${oid} and d.deptype = 'e')`;
const GRANTEE = "case when g.grantee = 0 then 'PUBLIC' else pg_get_userbyid(g.grantee) end";
const PRIVILEGES = "string_agg(g.privilege_type || case when g.is_grantable then ' (with grant option)' else '' end, ', ' order by g.privilege_type)";
const RELATION_KIND = "case c.relkind when 'r' then 'table' when 'p' then 'partitioned table' when 'v' then 'view' when 'm' then 'materialized view' when 'S' then 'sequence' when 'f' then 'foreign table' end";

/** One (key, definition) row per object, grant and policy in `public`. */
const DESCRIBE = [
  `select 'relation public.' || c.relname, ${RELATION_KIND}
     || case when c.relkind in ('r', 'p') then ', row level security ' || case when c.relrowsecurity then 'on' else 'off' end
        || case when c.relforcerowsecurity then ', forced' else '' end else '' end
     || case when c.relkind in ('v', 'm') then ': ' || pg_get_viewdef(c.oid) else '' end
   from pg_class c where c.relnamespace = 'public'::regnamespace and c.relkind in ('r', 'p', 'v', 'm', 'S', 'f') and ${NOT_EXTENSION("pg_class", "c.oid")}`,
  `select 'column public.' || c.relname || '.' || a.attname, format_type(a.atttypid, a.atttypmod)
     || case when a.attnotnull then ' not null' else '' end
     || coalesce(case when a.attgenerated = 's' then ' generated always as (' else ' default ' end || pg_get_expr(ad.adbin, ad.adrelid) || case when a.attgenerated = 's' then ')' else '' end, '')
     || case a.attidentity when 'a' then ' generated always as identity' when 'd' then ' generated by default as identity' else '' end
   from pg_attribute a join pg_class c on c.oid = a.attrelid left join pg_attrdef ad on ad.adrelid = a.attrelid and ad.adnum = a.attnum
   where c.relnamespace = 'public'::regnamespace and c.relkind in ('r', 'p', 'v', 'm', 'f') and a.attnum > 0 and not a.attisdropped and ${NOT_EXTENSION("pg_class", "c.oid")}`,
  `select 'constraint ' || con.conname || ' on public.' || c.relname, pg_get_constraintdef(con.oid)
   from pg_constraint con join pg_class c on c.oid = con.conrelid where c.relnamespace = 'public'::regnamespace`,
  `select 'index public.' || i.relname, pg_get_indexdef(i.oid)
   from pg_index x join pg_class i on i.oid = x.indexrelid where i.relnamespace = 'public'::regnamespace and ${NOT_EXTENSION("pg_class", "x.indrelid")}`,
  `select 'trigger ' || t.tgname || ' on public.' || c.relname, pg_get_triggerdef(t.oid)
   from pg_trigger t join pg_class c on c.oid = t.tgrelid where c.relnamespace = 'public'::regnamespace and not t.tgisinternal`,
  `select 'policy ' || policyname || ' on public.' || tablename,
     permissive || ' ' || cmd || ' to ' || array_to_string(roles, ', ') || coalesce(' USING (' || qual || ')', '') || coalesce(' WITH CHECK (' || with_check || ')', '')
   from pg_policies where schemaname = 'public'`,
  // A function's whole definition is long; its digest says whether the two match.
  `select 'function public.' || p.proname || '(' || pg_get_function_identity_arguments(p.oid) || ')',
     'definition sha256 ' || left(encode(sha256(convert_to(pg_get_functiondef(p.oid), 'UTF8')), 'hex'), 16)
   from pg_proc p where p.pronamespace = 'public'::regnamespace and p.prokind in ('f', 'p', 'w') and ${NOT_EXTENSION("pg_proc", "p.oid")}`,
  `select 'type public.' || t.typname, 'enum (' || string_agg(quote_literal(e.enumlabel), ', ' order by e.enumsortorder) || ')'
   from pg_type t join pg_enum e on e.enumtypid = t.oid where t.typnamespace = 'public'::regnamespace group by t.typname`,
  `select 'domain public.' || t.typname, format_type(t.typbasetype, t.typtypmod) || case when t.typnotnull then ' not null' else '' end
     || coalesce(' ' || (select string_agg(pg_get_constraintdef(con.oid), ' ' order by con.conname) from pg_constraint con where con.contypid = t.oid), '')
   from pg_type t where t.typnamespace = 'public'::regnamespace and t.typtype = 'd'`,
  `select 'grant on schema public to ' || ${GRANTEE}, ${PRIVILEGES}
   from pg_namespace n, aclexplode(coalesce(n.nspacl, acldefault('n'::"char", n.nspowner))) g where n.nspname = 'public' group by 1`,
  `select 'grant on ' || ${RELATION_KIND} || ' public.' || c.relname || ' to ' || ${GRANTEE}, ${PRIVILEGES}
   from pg_class c, aclexplode(coalesce(c.relacl, acldefault((case when c.relkind = 'S' then 's' else 'r' end)::"char", c.relowner))) g
   where c.relnamespace = 'public'::regnamespace and c.relkind in ('r', 'p', 'v', 'm', 'S', 'f') and ${NOT_EXTENSION("pg_class", "c.oid")} group by 1`,
  `select 'grant on column public.' || c.relname || '.' || a.attname || ' to ' || ${GRANTEE}, ${PRIVILEGES}
   from pg_attribute a join pg_class c on c.oid = a.attrelid, aclexplode(a.attacl) g
   where c.relnamespace = 'public'::regnamespace and a.attacl is not null and a.attnum > 0 and not a.attisdropped group by 1`,
  `select 'grant on function public.' || p.proname || '(' || pg_get_function_identity_arguments(p.oid) || ') to ' || ${GRANTEE}, ${PRIVILEGES}
   from pg_proc p, aclexplode(coalesce(p.proacl, acldefault('f'::"char", p.proowner))) g
   where p.pronamespace = 'public'::regnamespace and ${NOT_EXTENSION("pg_proc", "p.oid")} group by 1`,
  // What objects created later in public get: Supabase grants anon and authenticated through these.
  `select 'default privileges of ' || pg_get_userbyid(d.defaclrole) || case when d.defaclnamespace = 0 then ' everywhere' else ' in public' end
     || ' on ' || case d.defaclobjtype when 'r' then 'tables' when 'S' then 'sequences' when 'f' then 'functions' when 'T' then 'types' when 'n' then 'schemas' end
     || ' to ' || ${GRANTEE}, ${PRIVILEGES}
   from pg_default_acl d, aclexplode(d.defaclacl) g where d.defaclnamespace in (0, 'public'::regnamespace) group by 1`,
];

async function describeSchema(sql: Sql): Promise<Map<string, string>> {
  const schema = new Map<string, string>();
  for (const query of DESCRIBE) {
    // Each query's first column is the key and its second the definition.
    for (const [key, definition] of await sql.unsafe(query).values()) {
      schema.set(key, schema.has(key) ? `${schema.get(key)}; ${definition}` : String(definition));
    }
  }
  return schema;
}

const oneLine = (text: string) => text.replace(/\s+/g, " ").trim();

export const schemaDiff: Command = {
  name: "schema-diff",
  usage: "schema-diff staging production",
  environments: 2,
  bucket: false,
  async run({ targets, print, logStep }) {
    const [first, second] = targets as [Target, Target];
    const [a, b] = await Promise.all(targets.map((target) => readOnly(target.database, describeSchema)));
    const lines: string[] = [];
    for (const key of [...new Set([...a.keys(), ...b.keys()])].sort()) {
      const left = a.get(key), right = b.get(key);
      if (left === right) continue;
      if (right === undefined) lines.push(`  only in ${first.label}: ${key}: ${oneLine(left!)}`);
      else if (left === undefined) lines.push(`  only in ${second.label}: ${key}: ${oneLine(right)}`);
      else lines.push(`  differs: ${key}`, `    ${first.label}: ${oneLine(left)}`, `    ${second.label}: ${oneLine(right)}`);
    }
    const differences = lines.filter((line) => !line.startsWith("    ")).length;
    const result = differences ? "stop" : "ok";
    if (differences) {
      print(`Differences between ${first.label} and ${second.label} (public schema, grants and policies included):`);
      for (const line of lines) print(line);
      print(`Schema diff: stop. ${differences} difference(s). Bring ${first.label} level with ${second.label} by a migration, export first. Nothing was changed.`);
    } else {
      print(`No differences between ${first.label} and ${second.label} (${a.size} objects, grants and policies compared).`);
      print("Schema diff: ok. Nothing was changed.");
    }
    logStep({ step: "schema-diff", result, counts: { differences } });
    return result;
  },
};
