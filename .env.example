# Clerk (identity, sessions, organizations, memberships, invitations)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk JWT public key (PEM). Lets the server verify sessions without a
# network call on cold starts. Clerk Dashboard > API keys > JWT public key.
# Optional; the boot check warns when it is missing in production.
CLERK_JWT_KEY=

# Upstash Redis for the AI gate rate limiter (src/lib/rate-limit.ts).
# Required for AI review in every environment. Missing credentials or a failed
# limit check block the AI call; the draft stays available for retry.
# Production also requires both at startup.
# Vercel Marketplace > Upstash (or console.upstash.com) > REST URL and token.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Supabase (Postgres host + private attachment storage only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Database (Supabase Postgres connection string)
# Local/dev processes refuse a hosted URL that is not Lane Staging unless
# LANE_ALLOW_HOSTED_DB=1.
DATABASE_URL=
# Hosted connections always verify the certificate and hostname. If the server
# uses a private CA, copy its PEM certificate from Supabase Dashboard > Database
# Settings > SSL Configuration. Real newlines or literal \n are accepted.
# Leave empty to use Node's default trust. Invalid/untrusted CAs fail closed.
DATABASE_SSL_CA=

# Anthropic (for AI intake gate — Day 2)
ANTHROPIC_API_KEY=

# Triage token HMAC signing secret (generate: openssl rand -hex 32)
TRIAGE_TOKEN_SECRET=

# App URL (set to your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Error monitoring: GlitchTip, Sentry-compatible (src/lib/error-reporting.ts).
# GlitchTip > lane > Settings > Projects > Lane > Client Keys (DSN).
# Optional; unset means no events are sent. Production warns at boot without it.
# Public by design (the browser needs it to report); it can only create events.
NEXT_PUBLIC_SENTRY_DSN=

# Browser E2E mutates disposable fixtures in the pinned staging services.
# Leave unset normally. Set LANE_E2E_ALLOW_REMOTE=1 only for an approved test run.
# It never permits production or unowned-fixture cleanup.

# Inbox delivery (#206, spec #195): Needs-you items by email, one per item.
# Off by default. While LANE_EMAIL_DELIVERY is not exactly 1 (or a Resend name
# is missing), nothing is sent and the delivery log records "would send".
# Switch on only after the email service is approved. Resend > API Keys; the
# From address must be on a domain verified in Resend, e.g. Lane <inbox@uselane.app>.
LANE_EMAIL_DELIVERY=
RESEND_API_KEY=
LANE_EMAIL_FROM=
# Protects GET /api/inbox/daily (the one daily job). Unset: every call is refused.
# Vercel Cron sends it as "Authorization: Bearer <value>" (generate: openssl rand -hex 32).
CRON_SECRET=

# Slack DM (#207, spec #195): Admins connect Slack in Settings → Slack, then people
# can choose Slack DM for Needs-you items. Off by default. While LANE_SLACK_DELIVERY
# is not exactly 1 (or a name below is missing) there is no connect button, no
# Slack DM choice and no Slack traffic; anyone who chose Slack DM gets Email.
# Switch on only after the Slack app is approved. From the Lane app at
# api.slack.com/apps: Basic Information → Client ID / Client Secret. The app's
# redirect URL is <NEXT_PUBLIC_APP_URL>/api/slack/callback.
LANE_SLACK_DELIVERY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Encrypts the stored Slack tokens: 32 bytes as base64 or hex (openssl rand -base64 32).
# Changing it makes saved connections unusable until an Admin connects Slack again.
LANE_SLACK_TOKEN_KEY=
